# AntaresOS · Ghostty — Solar Black
# Desktop 1 = terminal  |  Desktop 2 = browser  |  Desktop 3 = comunicação

macos-option-as-alt = right

font-family = "ZedMono Nerd Font"
font-family = "FiraCode Nerd Font"
font-size = 19
font-thicken = true

# Solar Black — ouro quente em grafite profundo
background = 1a1a1a
foreground = e8e8d0
cursor-color = 7aa89f
cursor-text = 1a1a1a
selection-background = 2d2d2d
selection-foreground = e8e8d0

# ANSI palette — Solar Black
# 0=black 1=red 2=green 3=yellow(gold) 4=blue 5=magenta 6=cyan 7=white
palette = 0=#2d2d2d
palette = 1=#c4746e
palette = 2=#87a987
palette = 3=#e8c96a
palette = 4=#7fb4ca
palette = 5=#a48ca1
palette = 6=#7aa89f
palette = 7=#c5c9c5
palette = 8=#545450
palette = 9=#e46876
palette = 10=#8ca98c
palette = 11=#f0d080
palette = 12=#9fb5c9
palette = 13=#b35b79
palette = 14=#8ab8b5
palette = 15=#e8e8d0

background-opacity = 0.60
background-blur-radius = 25
minimum-contrast = 1.1
bold-is-bright = true

window-padding-x = 16
window-padding-y = 16
window-decoration = true
macos-titlebar-style = tabs
window-save-state = always

cursor-style = block
cursor-style-blink = true
shell-integration = zsh
shell-integration-features = cursor,sudo,title

mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
scrollback-limit = 100000

keybind = cmd+enter=toggle_fullscreen
keybind = cmd+k=clear_screen
