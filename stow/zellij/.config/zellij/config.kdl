// AntaresOS · Zellij — Ember Dark

theme "ember-dark"
default_layout "compact"
default_shell "zsh"

pane_frames true
mouse_mode true
copy_on_select true
copy_command "pbcopy"
scroll_buffer_size 100000

session_serialization true
serialize_pane_viewport true

plugins {
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        triggers "nvim|vim|fzf|zoxide|atuin|lazygit|git|less|man|mitmproxy|mitmweb"
        reaction_seconds "0.3"
        print_to_log false
    }
}
load_plugins {
    autolock
    "file:~/.config/zellij/plugins/zellij-attention.wasm" {
        enabled "true"
        waiting_icon "⏳"
        completed_icon "✅"
    }
}

keybinds {
    shared_except "locked" {
        bind "Ctrl h" { MoveFocusOrTab "Left"; }
        bind "Ctrl l" { MoveFocusOrTab "Right"; }
        bind "Ctrl j" { MoveFocus "Down"; }
        bind "Ctrl k" { MoveFocus "Up"; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Ctrl y" {
            LaunchOrFocusPlugin "file:~/zellij-plugins/zellij_forgot.wasm" {
                floating true
            }
        }
    }
}

// Ember Dark — carvão quente + âmbar dourado + lavanda
// Acento: #e8a020 (âmbar) · secundária: #a48ca1 (lavanda) · green: #87a987
themes {
    ember-dark {
        bg "#1a1612"
        fg "#e8d5a3"
        black "#1e1a14"
        red "#c4746e"
        green "#87a987"
        yellow "#e8c96a"
        blue "#7aa8c4"
        magenta "#a48ca1"
        cyan "#7aa89f"
        white "#e8d5a3"
        orange "#e8a020"

        text_unselected      { base "#e8d5a3"; background "#1a1612"; emphasis_0 "#e8a020"; emphasis_1 "#a48ca1"; emphasis_2 "#7aa8c4"; emphasis_3 "#87a987"; }
        text_selected        { base "#1a1612"; background "#e8a020"; emphasis_0 "#f0c060"; emphasis_1 "#a48ca1"; emphasis_2 "#7aa8c4"; emphasis_3 "#87a987"; }
        ribbon_selected      { base "#1a1612"; background "#e8a020"; emphasis_0 "#1a1612"; emphasis_1 "#1a1612"; emphasis_2 "#1a1612"; emphasis_3 "#1a1612"; }
        ribbon_unselected    { base "#7a6840"; background "#1a1612"; emphasis_0 "#7a6840"; emphasis_1 "#7a6840"; emphasis_2 "#7a6840"; emphasis_3 "#7a6840"; }
        table_title          { base "#e8a020"; background 0; emphasis_0 "#f0c060"; emphasis_1 "#e8a020"; emphasis_2 "#a48ca1"; emphasis_3 "#87a987"; }
        table_cell_selected  { base "#e8d5a3"; background "#252018"; emphasis_0 "#e8a020"; emphasis_1 "#a48ca1"; emphasis_2 "#7aa8c4"; emphasis_3 "#87a987"; }
        table_cell_unselected{ base "#e8d5a3"; background "#1a1612"; emphasis_0 "#e8a020"; emphasis_1 "#a48ca1"; emphasis_2 "#7aa8c4"; emphasis_3 "#87a987"; }
        list_selected        { base "#e8d5a3"; background "#252018"; emphasis_0 "#e8a020"; emphasis_1 "#a48ca1"; emphasis_2 "#7aa8c4"; emphasis_3 "#87a987"; }
        list_unselected      { base "#e8d5a3"; background "#1a1612"; emphasis_0 "#e8a020"; emphasis_1 "#a48ca1"; emphasis_2 "#7aa8c4"; emphasis_3 "#87a987"; }
        frame_unselected     { base "#2e2820"; background 0; emphasis_0 "#2e2820"; emphasis_1 "#2e2820"; emphasis_2 "#2e2820"; emphasis_3 "#2e2820"; }
        frame_selected       { base "#f0c060"; background 0; emphasis_0 "#f0c060"; emphasis_1 "#e8a020"; emphasis_2 "#a48ca1"; emphasis_3 "#87a987"; }
        frame_highlight      { base "#f0c060"; background 0; emphasis_0 "#f0c060"; emphasis_1 "#f0c060"; emphasis_2 "#f0c060"; emphasis_3 "#f0c060"; }
        exit_code_success    { base "#87a987"; background 0; emphasis_0 "#e8a020"; emphasis_1 "#87a987"; emphasis_2 "#7aa8c4"; emphasis_3 "#e8d5a3"; }
        exit_code_error      { base "#c4746e"; background 0; emphasis_0 "#c4746e"; emphasis_1 "#c4746e"; emphasis_2 "#c4746e"; emphasis_3 "#c4746e"; }
        multiplayer_user_colors { base "#e8a020"; background 0; emphasis_0 "#f0c060"; emphasis_1 "#87a987"; emphasis_2 "#a48ca1"; emphasis_3 "#c4746e"; }
    }
}
