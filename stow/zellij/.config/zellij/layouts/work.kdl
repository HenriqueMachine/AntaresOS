// AntaresOS · layout "work" — Ember Dark
// 4 tabs: 3 workspaces agnósticos de projeto + 1 nvim cheatsheet
// Tab bar: zjstatus (mode + tabs + git branch + hora)
// Abrir com: zellij -l work

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{mode}#[bg=#2e2820]{tabs}"
                format_right "#[fg=#a48ca1,bg=#2e2820]  {git_branch}#[fg=#7a6840,bg=#2e2820]  {datetime}"
                format_space "#[bg=#2e2820]"
                border_enabled "false"

                mode_normal  "#[bg=#87a987,fg=#1a1612,bold] NORMAL "
                mode_locked  "#[bg=#e8a020,fg=#1a1612,bold] LOCKED "
                mode_pane    "#[bg=#a48ca1,fg=#1a1612,bold] PANE "
                mode_tab     "#[bg=#f0c060,fg=#1a1612,bold] TAB "
                mode_resize  "#[bg=#d4820a,fg=#1a1612,bold] RESIZE "
                mode_scroll  "#[bg=#a48ca1,fg=#1a1612,bold] SCROLL "
                mode_search  "#[bg=#a48ca1,fg=#1a1612,bold] SEARCH "
                mode_session "#[bg=#e8a020,fg=#1a1612,bold] SESSION "

                tab_active    "#[fg=#1a1612,bg=#e8a020,bold] ▶ {name} "
                tab_normal    "#[fg=#e8a020,bg=#1a1612] {name} "
                tab_separator "#[fg=#e8a020,bg=#1a1612]"

                git_branch_format " {name} "
                git_branch_color  "#[fg=#a48ca1,bg=#2e2820]"
                git_branch_default " - "

                datetime          " {format} "
                datetime_format   " %d/%m  %H:%M"
                datetime_timezone "America/Sao_Paulo"
            }
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    new_tab_template {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "source $HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 0 · ENV-1
    tab name=" ENV-1" focus=true {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "source $HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 1 · ENV-2
    tab name=" ENV-2" {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "source $HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 2 · ENV-3
    tab name=" ENV-3" {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "source $HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 3 · NVIM — cheatsheet de atalhos + shell para praticar
    tab name=" NVIM" {
        pane split_direction="vertical" {
            pane size="65%" name="cheatsheet" {
                command "zsh"
                args "-ic" "nvim ~/Github/AntaresOS/library/cheats/nvim-atalhos.md; exec zsh -i"
            }
            pane size="35%" name="prática"
        }
    }
}
