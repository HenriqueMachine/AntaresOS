// AntaresOS · layout "work" — Ice Black · imersivo
// 4 tabs: 3 workspaces agnósticos de projeto + 1 nvim cheatsheet
// Tab bar: zjstatus (mode + tabs · git · hora)
// Claude: zellij-attention (⏳/✅ no nome da tab)
// Abrir com: zellij -l work

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{mode}#[bg=#111d2e]{tabs}"
                format_right "#[fg=#3a5070,bg=#111d2e] {datetime}"
                format_space "#[bg=#111d2e]"
                border_enabled "false"

                mode_normal  "#[bg=#3dd68c,fg=#080d14,bold] NORMAL "
                mode_locked  "#[bg=#ffb454,fg=#080d14,bold] LOCKED "
                mode_pane    "#[bg=#3dc9e9,fg=#080d14,bold] PANE "
                mode_tab     "#[bg=#4f9cf9,fg=#080d14,bold] TAB "
                mode_resize  "#[bg=#ffb454,fg=#080d14,bold] RESIZE "
                mode_scroll  "#[bg=#c77dff,fg=#080d14,bold] SCROLL "
                mode_search  "#[bg=#c77dff,fg=#080d14,bold] SEARCH "
                mode_session "#[bg=#3dc9e9,fg=#080d14,bold] SESSION "

                tab_active   "#[fg=#3dc9e9,bg=#080d14,bold] ▶ {name} "
                tab_normal   "#[fg=#080d14,bg=#3dc9e9] {name} "
                tab_separator "#[fg=#3dc9e9,bg=#080d14]"

                datetime          " {format} "
                datetime_format   " %d/%m  %H:%M"
                datetime_timezone "America/Sao_Paulo"
            }
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    new_tab_template {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane size="25%" name="logs" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane name="shell" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
            }
        }
    }

    // 0 · ENV-1
    tab name=" ENV-1" focus=true {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane size="25%" name="logs" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane name="shell" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
            }
        }
    }

    // 1 · ENV-2
    tab name=" ENV-2" {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane size="25%" name="logs" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane name="shell" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
            }
        }
    }

    // 2 · ENV-3
    tab name=" ENV-3" {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane size="25%" name="logs" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
                pane name="shell" {
                    command "zsh"
                    args "-ic" "exec zsh"
                }
            }
        }
    }

    // 3 · NVIM — cheatsheet de atalhos + shell para praticar
    tab name=" NVIM" {
        pane split_direction="vertical" {
            pane size="65%" name="cheatsheet" {
                command "zsh"
                args "-ic" "nvim ~/Github/AntaresOS/library/cheats/nvim-atalhos.md"
            }
            pane size="35%" name="prática" {
                command "zsh"
                args "-ic" "exec zsh"
            }
        }
    }
}
