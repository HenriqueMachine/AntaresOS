// AntaresOS · layout "work" — Ember Dark
// 4 tabs: 3 workspaces + 1 nvim cheatsheet
// Tab bar: nativa do Zellij (ribbon_selected/unselected do tema ember-dark)

layout {
    // 0 · ENV-1
    tab name=" ENV-1" focus=true {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 1 · ENV-2
    tab name=" ENV-2" {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 2 · ENV-3
    tab name=" ENV-3" {
        pane split_direction="vertical" {
            pane size="40%" name="claude" {
                command "zsh"
                args "-ic" "$HOME/Github/AntaresOS/scripts/workspace-init.sh; exec zsh -i"
            }
            pane split_direction="horizontal" {
                pane size="55%" name="nvim"
                pane size="25%" name="logs"
                pane name="shell"
            }
        }
    }

    // 3 · NVIM — cheatsheet + prática
    tab name=" NVIM" {
        pane split_direction="vertical" {
            pane size="65%" name="cheatsheet" {
                command "zsh"
                args "-ic" "nvim ~/Github/AntaresOS/library/cheats/nvim-atalhos.md; exec zsh -i"
            }
            pane size="35%" name="prática"
        }
    }
}
